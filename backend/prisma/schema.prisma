// Nexora Multi-Vendor Sales Portal — Core Schema (Phase 1: Super Admin + Vendor + Catalog + Orders)
// Chat, attendance/leads, loyalty, and referral tables are stubbed at the end for Phase 2.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH / RBAC
// ---------------------------------------------------------------------------

enum RoleName {
  SUPER_ADMIN
  VENDOR
  FIELD_SALES_OFFICER
  CUSTOMER
}

model Role {
  id          Int      @id @default(autoincrement())
  name        RoleName @unique
  description String?  @db.VarChar(255)
  users       User[]
  createdAt   DateTime @default(now())

  @@map("roles")
}

model User {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  name          String    @db.VarChar(120)
  email         String    @unique @db.VarChar(160)
  phone         String?   @db.VarChar(20)
  passwordHash  String    @map("password_hash")
  roleId        Int       @map("role_id")
  role          Role      @relation(fields: [roleId], references: [id])
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")
  refreshToken  String?   @map("refresh_token") @db.VarChar(500)
  lastLoginAt   DateTime? @map("last_login_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  resetPasswordToken   String?   @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires DateTime? @map("reset_password_expires")

  vendor            Vendor?
  customer          Customer?
  fieldSalesOfficer FieldSalesOfficer?
  activityLogs      ActivityLog[]
  notifications     Notification[]

  @@index([roleId])
  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// VENDOR
// ---------------------------------------------------------------------------

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

model Vendor {
  id            Int          @id @default(autoincrement())
  userId        Int          @unique @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName     String       @db.VarChar(160)
  storeSlug     String       @unique @db.VarChar(180)
  gstNumber     String?      @map("gst_number") @db.VarChar(30)
  status        VendorStatus @default(PENDING)
  commissionPct Decimal      @default(10.00) @map("commission_pct") @db.Decimal(5, 2)
  rating        Decimal      @default(0.00) @db.Decimal(3, 2)
  address       String?      @db.VarChar(255)
  city          String?      @db.VarChar(100)
  state         String?      @db.VarChar(100)
  pincode       String?      @db.VarChar(12)
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  businessName       String?   @map("business_name") @db.VarChar(160)
  phone              String?   @db.VarChar(20)
  description        String?   @db.Text
  logo               String?   @db.VarChar(500)
  banner             String?   @db.VarChar(500)
  accountHolder      String?   @map("account_holder") @db.VarChar(160)
  accountNumber      String?   @map("account_number") @db.VarChar(40)
  ifscCode           String?   @map("ifsc_code") @db.VarChar(20)
  bankName           String?   @map("bank_name") @db.VarChar(160)
  panNumber          String?   @map("pan_number") @db.VarChar(20)
  aadhaar            String?   @db.VarChar(20)
  pan                String?   @db.VarChar(20)
  gst                String?   @db.VarChar(30)
  kycStatus          String    @default("NOT_SUBMITTED") @map("kyc_status") @db.VarChar(20)
  emailNotifications Boolean   @default(true) @map("email_notifications")
  smsNotifications   Boolean   @default(true) @map("sms_notifications")
  pushNotifications  Boolean   @default(true) @map("push_notifications")
  socialLinks        Json?     @map("social_links")
  website            String?   @db.VarChar(255)
  registrationNumber String?   @map("registration_number") @db.VarChar(60)
  supportHours       String?   @map("support_hours") @db.VarChar(100)
  primaryColor       String?   @map("primary_color") @db.VarChar(20)
  secondaryColor     String?   @map("secondary_color") @db.VarChar(20)
  fontFamily         String?   @map("font_family") @db.VarChar(60)

  products           Product[]
  orderItems         OrderItem[]
  coupons            Coupon[]
  inventory          Inventory[]
  audiencesegment    audiencesegment[]
  warehouses         Warehouse[]
  marketingcampaign  marketingcampaign[]
  brands             Brand[]
  supportTickets     SupportTicket[]

  @@index([status])
  @@map("vendors")
}

// ---------------------------------------------------------------------------
// CUSTOMER / FIELD SALES OFFICER
// ---------------------------------------------------------------------------

model Customer {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletBalance Decimal @default(0.00) @map("wallet_balance") @db.Decimal(10, 2)
  loyaltyPoints Int     @default(0) @map("loyalty_points")
  referralCode  String  @unique @map("referral_code") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  orders    Order[]
  carts     Cart[]
  wishlist  Wishlist[]
  reviews   Review[]
  addresses Address[]

  @@map("customers")
}

model FieldSalesOfficer {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String @unique @map("employee_code") @db.VarChar(30)
  region     String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("field_sales_officers")
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(120)
  slug      String     @unique @db.VarChar(140)
  parentId  Int?       @map("parent_id")
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  iconUrl   String?    @map("icon_url") @db.VarChar(500)
  isActive  Boolean    @default(true) @map("is_active")
  products  Product[]
  brands    Brand[]

  @@index([parentId])
  @@map("categories")
}

model Brand {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(120)
  logoUrl     String?     @map("logo_url") @db.VarChar(500)
  website     String?     @db.VarChar(255)
  categoryId  Int?        @map("category_id")
  status      BrandStatus @default(PENDING)
  createdBy   Int?        @map("created_by_vendor_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  category    Category?   @relation(fields: [categoryId], references: [id])
  vendor      Vendor?     @relation(fields: [createdBy], references: [id])
  products    Product[]

  @@index([categoryId])
  @@index([createdBy], map: "brands_created_by_vendor_id_fkey")
  @@map("brands")
}

enum BrandStatus {
  APPROVED
  PENDING
  REVIEW
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

model Product {
  id           Int           @id @default(autoincrement())
  vendorId     Int           @map("vendor_id")
  vendor       Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  categoryId   Int           @map("category_id")
  category     Category      @relation(fields: [categoryId], references: [id])
  brandId      Int?          @map("brand_id")
  brand        Brand?        @relation(fields: [brandId], references: [id])
  name         String        @db.VarChar(200)
  slug         String        @unique @db.VarChar(220)
  description  String?       @db.Text
  sku          String        @unique @db.VarChar(60)
  price        Decimal       @db.Decimal(10, 2)
  mrp          Decimal       @db.Decimal(10, 2)
  status       ProductStatus @default(DRAFT)
  ratingAvg    Decimal       @default(0.00) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int           @default(0) @map("rating_count")
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  images     ProductImage[]
  inventory  Inventory?
  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]
  wishlist   Wishlist[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@fulltext([name])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.VarChar(500)
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id            Int      @id @default(autoincrement())
  productId     Int      @unique @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId      Int      @map("vendor_id")
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  quantity      Int      @default(0)
  reservedQty   Int      @default(0) @map("reserved_qty")
  lowStockAlert Int      @default(5) @map("low_stock_alert")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([vendorId])
  @@map("inventory")
}

// ---------------------------------------------------------------------------
// ORDERS / PAYMENTS
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

model Order {
  id             Int         @id @default(autoincrement())
  orderNumber    String      @unique @map("order_number") @db.VarChar(30)
  customerId     Int         @map("customer_id")
  customer       Customer    @relation(fields: [customerId], references: [id])
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountTotal  Decimal     @default(0.00) @map("discount_total") @db.Decimal(10, 2)
  shippingTotal  Decimal     @default(0.00) @map("shipping_total") @db.Decimal(10, 2)
  grandTotal     Decimal     @map("grand_total") @db.Decimal(10, 2)
  couponId       Int?        @map("coupon_id")
  coupon         Coupon?     @relation(fields: [couponId], references: [id])
  shippingAddress String     @map("shipping_address") @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  trackingNumber String?     @map("tracking_number") @db.VarChar(80)
  courierName    String?     @map("courier_name") @db.VarChar(120)

  items    OrderItem[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  vendorId  Int      @map("vendor_id")
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(10, 2)
  commissionAmount Decimal @default(0.00) @map("commission_amount") @db.Decimal(10, 2)

  @@index([orderId])
  @@index([vendorId])
  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id        Int           @id @default(autoincrement())
  orderId   Int           @map("order_id")
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String        @db.VarChar(30) // stripe | razorpay | wallet
  providerRefId String?   @map("provider_ref_id") @db.VarChar(120)
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")

  transactions Transaction[]

  @@index([orderId])
  @@map("payments")
}

model Transaction {
  id        Int      @id @default(autoincrement())
  paymentId Int      @map("payment_id")
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(20) // charge | refund | payout
  amount    Decimal  @db.Decimal(10, 2)
  meta      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("transactions")
}

// ---------------------------------------------------------------------------
// CART / WISHLIST / REVIEWS / COUPONS
// ---------------------------------------------------------------------------

model Cart {
  id         Int        @id @default(autoincrement())
  customerId Int        @map("customer_id")
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now()) @map("created_at")
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int     @map("cart_id")
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@index([cartId])
  @@map("cart_items")
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([customerId, productId])
  @@map("wishlists")
}

model Review {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("reviews")
}

enum CouponType {
  PERCENTAGE
  FLAT
}

model Coupon {
  id          Int        @id @default(autoincrement())
  code        String     @unique @db.VarChar(30)
  vendorId    Int?       @map("vendor_id")
  vendor      Vendor?    @relation(fields: [vendorId], references: [id])
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  minOrderAmt Decimal    @default(0.00) @map("min_order_amt") @db.Decimal(10, 2)
  maxUses     Int        @default(0) @map("max_uses")
  usedCount   Int        @default(0) @map("used_count")
  expiresAt   DateTime?  @map("expires_at")
  isActive    Boolean    @default(true) @map("is_active")

  orders Order[]

  @@map("coupons")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS / ACTIVITY LOGS
// ---------------------------------------------------------------------------

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(500)
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")
  type      String    @default("INFO") @db.VarChar(30)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, type])
  @@map("notifications")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(120)
  entity    String   @db.VarChar(60)
  entityId  Int?     @map("entity_id")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  meta      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity, entityId])
  @@map("activity_logs")
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  target    String   @unique @db.VarChar(160) // email or phone number
  otp       String   @db.VarChar(10)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model Address {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title         String   @db.VarChar(50)
  recipientName String   @map("recipient_name") @db.VarChar(120)
  phone         String   @db.VarChar(20)
  street        String   @db.VarChar(255)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(100)
  pincode       String   @db.VarChar(12)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("addresses")
}

model Warehouse {

 id Int @id @default(autoincrement())

 vendorId Int

 name String

 location String

 stockUnits Int @default(0)

 pendingDispatch Int @default(0)

 completedOrders Int @default(0)

 status String

 createdAt DateTime @default(now())

 updatedAt DateTime @updatedAt

 vendor Vendor @relation(fields:[vendorId], references:[id])

 @@index([vendorId])

}



model SupportTicket {
  id           Int      @id @default(autoincrement())
  vendorId     Int
  customerId   Int?
  ticketNumber String   @unique
  subject      String
  description  String
  priority     String   @default("MEDIUM")
  status       String   @default("OPEN")
  assignedTo   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  vendor       Vendor   @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@map("support_tickets")
}


model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}


model NotificationQueue {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@map("notification_queue")
}


model ActivityTimeline {
  id          String   @id @default(cuid())
  vendorId    String
  action      String
  description String
  createdAt   DateTime @default(now())

  @@map("activity_timeline")
}


model audiencesegment {
  id          String   @id
  vendorId    Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  vendors     Vendor   @relation(fields: [vendorId], references: [id], map: "AudienceSegment_vendorId_fkey")

  @@index([vendorId], map: "AudienceSegment_vendorId_fkey")
}


model giftcard {
  id         String    @id
  code       String    @unique(map: "GiftCard_code_key")
  amount     Float
  status     String    @default("ACTIVE")
  expiryDate DateTime?
  createdAt  DateTime  @default(now())
}


model loyaltytransaction {
  id          String   @id
  customerId  String
  points      Int
  type        String
  description String?
  createdAt   DateTime @default(now())
}


model marketingcampaign {
  id           String    @id
  vendorId     Int
  name         String
  campaignType String
  subject      String?
  content      String
  audienceType String
  status       String    @default("DRAFT")
  sentCount    Int       @default(0)
  openCount    Int       @default(0)
  clickCount   Int       @default(0)
  scheduledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  vendors      Vendor    @relation(fields: [vendorId], references: [id], map: "MarketingCampaign_vendorId_fkey")

  @@index([vendorId], map: "MarketingCampaign_vendorId_fkey")
}


model referral {
  id           String   @id
  referrerId   String
  referredId   String?
  referralCode String   @unique(map: "Referral_referralCode_key")
  rewardPoints Int      @default(100)
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}


model rewardpoint {
  id         String   @id
  customerId String
  points     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}


model wallet {
  id         String   @id
  customerId String   @unique(map: "Wallet_customerId_key")
  balance    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}


model wallettransaction {
  id          String   @id
  walletId    String
  amount      Float
  type        String
  description String?
  createdAt   DateTime @default(now())
}
